#inside ~/.ssh/config
# No IdentityFile here on purpose. Each git identity picks its key via
# core.sshCommand (with IdentitiesOnly=yes) in ~/.gitconfig.<identity>.
# Listing keys under Host * makes SSH offer them first and log in as the wrong account.
Host *
  IgnoreUnknown AddKeysToAgent,UseKeychain
  AddKeysToAgent yes
  UseKeychain yes

# stuff for colima ? 
Include /Users/carlos.salazar/.colima/ssh_config
